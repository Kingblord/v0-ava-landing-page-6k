# ========================
# FIREBASE - REQUIRED
# ========================
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_bucket.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin (Server-side, backend only)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ========================
# WHATSAPP GATEWAY
# ========================
WHATSAPP_GATEWAY_URL=http://localhost:3001
NEXT_PUBLIC_GATEWAY_URL=https://aromsg.up.railway.app

# ========================
# AI & OPENROUTER
# ========================
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=google/gemini-2.0-flash-exp

# ========================
# INTERNAL SECURITY
# ========================
INTERNAL_API_KEY=your_secure_random_key_for_webhook_verification

# ========================
# APPLICATION URLS
# ========================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ========================
# OPTIONAL: CLOUDINARY (if using image uploads)
# ========================
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ========================
# OPTIONAL: DEPLOYMENT
# ========================
# VERCEL_URL=auto-set-by-vercel
# NODE_ENV=production
# PORT=3000
